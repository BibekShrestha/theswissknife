exports[`outputs per target > Hand-written: -u, clustered flags, several -d and --data-urlencode → Go net/http 1`] = `
"package main

import (
	"crypto/tls"
	"fmt"
	"io"
	"log"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("POST", "https://api.example.com/v1/charges", strings.NewReader("amount=500&currency=usd&description=Two%20widgets%20%26%20a%20gadget"))
	if err != nil {
		log.Fatal(err)
	}

	req.SetBasicAuth("demo_user", "demo-pass-1")

	req.Header.Set("Idempotency-Key", "7a1f")
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")

	client := &http.Client{
		Transport: &http.Transport{
			TLSClientConfig: &tls.Config{InsecureSkipVerify: true}, // curl -k
		},
	}
	resp, err := client.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(resp.Status)
	fmt.Printf("%s\\n", data)
}
"
`;

