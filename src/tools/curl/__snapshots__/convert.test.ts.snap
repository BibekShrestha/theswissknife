    ('name', (None, 'report')),
    ('file', ('q3.csv', open('./q3.csv', 'rb'), 'text/csv')),
    ('meta', (None, open('meta.json', 'rb').read())),
]

response = requests.post(
    'https://upload.example.com/v1/import',
    headers=headers,
    files=files,
    allow_redirects=False,
)

print(response.status_code)
