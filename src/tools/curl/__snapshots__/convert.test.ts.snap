exports[`outputs per target > Chrome bash: POST JSON with a bearer token → Go net/http 1`] = `
"package main

import (
	"fmt"
	"io"
	"log"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("POST", "https://api.example.com/graphql", strings.NewReader(\`{"operationName":"Orders","variables":{"first":20,"after":null},"query":"query Orders { orders { id } }"}\`))
	if err != nil {
		log.Fatal(err)
	}

	req.Header.Set("accept", "*/*")
	req.Header.Set("authorization", "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkZW1vIn0.ZGVtby1zaWduYXR1cmU")
	req.Header.Set("content-type", "application/json")
	req.Header.Set("origin", "https://app.example.com")

	client := &http.Client{
		// curl does not follow redirects without -L
		CheckRedirect: func(req *http.Request, via []*http.Request) error {
			return http.ErrUseLastResponse
		},
	}
	resp, err := client.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(resp.Status)
	fmt.Printf("%s\\n", data)
}
"
`;

