exports[`outputs per target > Hand-written: -F parts, -A, -e → Go net/http 1`] = `
"package main

import (
	"bytes"
	"fmt"
	"io"
	"log"
	"mime/multipart"
	"net/http"
	"net/textproto"
	"os"
)

func main() {
	var body bytes.Buffer
	form := multipart.NewWriter(&body)
	form.WriteField("name", "report")
	{
		part, err := form.CreatePart(textproto.MIMEHeader{
			"Content-Disposition": {"form-data; name=\\"file\\"; filename=\\"q3.csv\\""},
			"Content-Type":        {"text/csv"},
		})
		if err != nil {
			log.Fatal(err)
		}
		file, err := os.Open("./q3.csv")
		if err != nil {
			log.Fatal(err)
		}
		io.Copy(part, file)
		file.Close()
	}
	{
		part, err := form.CreatePart(textproto.MIMEHeader{
			"Content-Disposition": {"form-data; name=\\"meta\\""},
		})
		if err != nil {
			log.Fatal(err)
		}
		file, err := os.Open("meta.json")
		if err != nil {
			log.Fatal(err)
		}
		io.Copy(part, file)
		file.Close()
	}
	form.Close()

	req, err := http.NewRequest("POST", "https://upload.example.com/v1/import", &body)
	if err != nil {
		log.Fatal(err)
	}

	req.Header.Set("Content-Type", form.FormDataContentType())

	req.Header.Set("User-Agent", "importer/2.1")
	req.Header.Set("Referer", "https://example.com/")

	client := &http.Client{
		// curl does not follow redirects without -L
		CheckRedirect: func(req *http.Request, via []*http.Request) error {
			return http.ErrUseLastResponse
		},
	}
	resp, err := client.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(resp.Status)
	fmt.Printf("%s\\n", data)
}
"
`;

exports[`outputs per target > Hand-written: -F parts, -A, -e → JavaScript 1`] = `
"import { openAsBlob } from 'node:fs';
import { readFile } from 'node:fs/promises';

// In a browser, fetch() silently drops forbidden headers: referer
const form = new FormData();
form.append('name', 'report');
form.append('file', await openAsBlob('./q3.csv', { type: 'text/csv' }), 'q3.csv');
form.append('meta', await readFile('meta.json', 'utf8'));

const response = await fetch('https://upload.example.com/v1/import', {
  method: 'POST',
  headers: {
    'User-Agent': 'importer/2.1',
    'Referer': 'https://example.com/',
  },
  body: form,
  redirect: 'manual', // curl does not follow redirects without -L
});

console.log(response.status);
console.log(await response.text());
"
`;

