exports[`outputs per target > Chrome bash: $'…' body with a quote, ! and newlines → Go net/http 1`] = `
"package main

import (
	"fmt"
	"io"
	"log"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("PUT", "https://api.example.com/notes", strings.NewReader("It's done!\\nSecond line — ok"))
	if err != nil {
		log.Fatal(err)
	}

	req.Header.Set("content-type", "text/plain;charset=UTF-8")

	client := &http.Client{
		// curl does not follow redirects without -L
		CheckRedirect: func(req *http.Request, via []*http.Request) error {
			return http.ErrUseLastResponse
		},
	}
	resp, err := client.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(resp.Status)
	fmt.Printf("%s\\n", data)
}
"
`;

