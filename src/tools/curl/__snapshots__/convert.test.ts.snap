exports[`outputs per target > Firefox POSIX: one line, Latin-1 \\x escapes, Basic auth → Go net/http 1`] = `
"package main

import (
	"fmt"
	"io"
	"log"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("PUT", "https://example.com/api/profile", strings.NewReader(\`{"name":"Renée","bio":"It's 5€"}\`))
	if err != nil {
		log.Fatal(err)
	}

	req.Header.Set("User-Agent", "Mozilla/5.0 (X11; Linux x86_64; rv:131.0) Gecko/20100101 Firefox/131.0")
	req.Header.Set("Accept", "application/json")
	req.Header.Set("Accept-Language", "en-US,en;q=0.5")
	req.Header.Set("Accept-Encoding", "gzip, deflate, br, zstd")
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Basic ZGVtbzpkZW1vLXBhc3M=")
	req.Header.Set("Origin", "https://example.com")
	req.Header.Set("Connection", "keep-alive")
	req.Header.Set("Cookie", "csrftoken=demo_csrf_998877")

	client := &http.Client{
		// curl does not follow redirects without -L
		CheckRedirect: func(req *http.Request, via []*http.Request) error {
			return http.ErrUseLastResponse
		},
	}
	resp, err := client.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(resp.Status)
	fmt.Printf("%s\\n", data)
}
"
`;

